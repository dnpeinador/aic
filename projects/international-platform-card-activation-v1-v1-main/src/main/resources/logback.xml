<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Includes default configuration from Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Status listener to ignore status messages from Logback -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Sets the context name to the hostname of the machine where the application is running -->
    <contextName>${HOSTNAME}</contextName>

    <!-- Spring properties to fetch application name and version -->
    <springProperty name = "appname" source= "spring.application.name"/>
    <springProperty name = "version" source= "spring.application.version"/>

    <!-- Log level and format properties with default values -->
    <property name="log_level" value="${LOG_LEVEL:-INFO}" />
    <property name="request_log_level" value="${REQUEST_LOG_LEVEL:-INFO}" />
    <property name="log_format" value="${LOG_FORMAT:-console}" />

    <!-- Console log pattern property -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(application_name:${appname:-} application_version:${version:-}){faint} %clr(@timestamp:%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(log_level:${LOG_LEVEL_PATTERN:-%5p}) %clr(log_type:${log_level:-}){orange} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(message:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- Console Appender-->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- JSON Console Appender-->
    <appender name="console_json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                </timestamp>
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
                <callerData>
                    <classFieldName>class</classFieldName>
                    <methodFieldName>method</methodFieldName>
                    <lineFieldName>line</lineFieldName>
                </callerData>
                <logLevel>
                    <fieldName>log_level</fieldName>
                </logLevel>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <pattern>
                    <pattern>
                        {
                        "pid": "${PID:- }",
                        "hostname": "%contextName",
                        "application_name": "${appname:-}",
                        "application_version": "${version:-}",
                        "log_level": "${LOG_LEVEL_PATTERN:-%5p}",
                        "log_type": "${log_level:-}",
                        "trace_id": "%mdc{trace_id:-}",
                        "span_id": "%mdc{span_id:-}",
                        "span_parent_id": "%mdc{parent_id:-}",
                        "exportable": "%mdc{sampled:-}",
                        "trace_flags": "%mdc{traceFlags:-}"
                        }
                    </pattern>
                    <charset>utf8</charset>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- Logger for org.zalando.logbook.Logbook with level and appender -->
    <logger name="org.zalando.logbook.Logbook" level="${request_log_level}" additivity="false">
        <appender-ref ref="${log_format}"/>
    </logger>

    <!-- Root logger with level and appender -->
    <root level="${log_level}">
        <appender-ref ref="${log_format}"/>
    </root>
</configuration>